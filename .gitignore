# Runtime and data roots (never commit local corpora or indexes).
# Anchored to the repository root: an unanchored `data/` also matches
# `tests/data/`, which silently excluded the golden query fixture that the
# evaluation tests and scripts read.
/data/
/sources/

# Vendored upstream used only to build the index; see README "构建索引".
# The runtime data root (e.g. C:\RAG-Agent-Data) lives outside the repository,
# so it needs no rule here.
LangGraph-Chatchat/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/

# Test / coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Editors and OS
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# Secrets — API keys are read from the environment, never from files
.env
.env.*
*.key
*.pem
